# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/mui

# --- JWT ---
# REQUIRED. Never commit a real value. The app refuses to start in production
# without it.
JWT_SECRET=

# --- Initial admin (only used when the users collection is empty) ---
# REQUIRED in production. Min 8 chars.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Monitoring ---
# Cron expression for the SSH metrics collector (default: every 10 minutes).
MONITOR_INTERVAL=*/10 * * * *

# --- Panel ---
PORT=3000
